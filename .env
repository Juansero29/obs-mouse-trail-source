# OBS installation root.
# Windows example: D:/Programs/OBS28/obs-studio
# Linux example: /usr
# macOS example: /Applications/OBS.app
OBS_ROOT=D:/Programs/OBS28/obs-studio

# CMake build folder
BUILD_DIR=build

# Build type used for single-config generators (Ninja/Make)
CMAKE_BUILD_TYPE=Release

# Optional: generator and config for multi-config generators
# CMAKE_GENERATOR=Ninja
# CMAKE_BUILD_CONFIG=Release

# Optional: override OBS SDK paths if needed by your environment
# OBS_HEADERS_DIR=.deps/obs-studio-src/libobs
# OBS_CONFIG_DIR=.deps/obs-studio-src/build_x64/config
# OBS_LIB_PATH=.deps/lib/libobs.dll.a

# Optional Windows-only runtime copy path
# MINGW_BIN=C:/Strawberry/c/bin
